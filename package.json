{
  "name": "temp3",
  "version": "0.1.1",
  "description": "해양시스템공사부 Work Order 관리 시스템",
  "author": "해양시스템공사부",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 4200",
    "build": "next build",
    "start": "next start -p 4200",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "publish:win": "node scripts/publish-release.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "com.hyundai-marine.workorder",
    "productName": "WorkOrder",
    "asar": false,
    "afterPack": "scripts/after-pack.js",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "package.json",
          ".next/**/*",
          "node_modules/**/*",
          "public/**/*",
          "prisma/**/*",
          "next.config.ts"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
